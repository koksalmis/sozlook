{
  "manifest_version": 3,
  "name": "Sözlook",
  "version": "0.1.0",
  "description": "İngilizce kelimeleri seç, anlamlarına bak ve cümleleriyle kaydet.",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Sözlook · Kelimelerim",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["data.js", "core.js", "storage.js", "content.js"],
    "run_at": "document_idle"
  }]
}
